{
  "schemaVersion": 1,
  "id": "midgetcontrol",
  "version": "${version}",
  "name": "MidgetControl",
  "description": "Lightweight natural-spawn controls, player information, locator-blip privacy, and a tab-list display for Fabric servers.",
  "authors": [
    "threadcreator"
  ],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.midgetcontrol.MidgetControl"
    ]
  },
  "mixins": [
    "midgetcontrol.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api-base": "*",
    "fabric-command-api-v2": "*",
    "fabric-entity-events-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}

